# Credenciales de ByteDance Ark / Seedance.
# Copia a .env y rellena. NUNCA commitees el .env real.

# Obligatorio: token Bearer del servicio Ark (region southeast-1).
SEEDANCE_API_KEY=

# Opcional: endpoint base. Default regional para BytePlus.
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com

# Opcional: donde guardar el registro local de tareas.
SEEDANCE_STATE_DIR=

# Opcional: segundos max de espera al hacer polling.
SEEDANCE_POLL_MAX=300

# ---------------------------------------------------------------------------
# Cloudflare R2 (opcional)
# Sin esto el server funciona igual, pero los videos solo viven 24h porque la
# URL de ByteDance viene firmada. Con R2 obtenes URLs permanentes.
# ---------------------------------------------------------------------------
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
